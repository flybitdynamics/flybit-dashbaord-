rules_version = '2';

// Security rules for the FlyBit desk (project flybit-530c5).
//
// Paste into Firebase console -> Firestore Database -> Rules -> Publish.
//
// ⚠️  THESE RULES ARE OPEN. Anyone who knows the project id can read and
//     write every booking, client phone number and payment record. They are
//     here so the desk works today, not because they are safe.
//
//     Swap in the AUTHENTICATED block at the bottom as soon as login exists.

service cloud.firestore {
  match /databases/{database}/documents {

    match /shows/{showId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    // Nothing else in this project is used by the desk.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

